{% extends 'emails/base.html.twig' %}

{% block title %}Your login code{% endblock %}

{% block content %}
    <h1>Your login code</h1>

    <p>Use the following code to log in to PiposDocuments:</p>

    <p style="text-align: center; font-size: 32px; font-weight: bold; letter-spacing: 8px; color: #1a1a1a; padding: 20px; background: #f0f0f0; border-radius: 8px;">
        {{ code }}
    </p>

    <p>This code will expire in {{ expires_in_minutes }} minutes.</p>

    <p style="font-size: 12px; color: #666; margin-top: 30px;">
        If you didn't request a login code, you can safely ignore this email.
    </p>
{% endblock %}